# Oracle DB Config
ICV_DB_USER=
ICV_DB_PASSWORD=
ICV_DB_CONNECT_STRING=
# Ruta del Oracle Instant Client (solo Linux; en Windows se usa la ruta fija de db/icv_config.js)
ORACLE_LIB_DIR=

# Enrollment Config
ICV_URL_FOTO=
ICV_LOTE=50
ICV_CONCURRENCIA=5

ICV_SOAP_USER=
ICV_SOAP_PASS=

# Modo de enrolamiento ICV: anio (por año de fecha_pago) | procesada (solo procesada = 0, incluye fecha_pago NULL)
ICV_MODO=anio
# Años a procesar en modo anio, separados por coma
ICV_ANIOS=2026

# Control de carga ICV (0 = deshabilitado)
ICV_MAX_REGISTROS=2500
ICV_PAUSA_LOTE_MS=2000
# Circuit breaker: detiene la ejecución si un lote supera el % de errores transitorios o el promedio de Regula (ms)
ICV_MAX_ERROR_PCT=30
ICV_MAX_REGULA_MS=5000

# Scheduler / ventana global de enrolamientos
# Hora (HH:MM) en que se dejan de iniciar lotes y scripts nuevos
ENROL_HORA_LIMITE=05:00
# Tiempo máximo por tarea antes de detenerla (horas)
ENROL_MAX_HORAS_TAREA=23

# Regula Config
REGULA_URL=http://localhost:41101
REGULA_ICV_GROUP_ID=
BIOMETRIC_API_SECRET=

# DGA Config
DGA_API_KEY=
DGA_LIMIT=50
DGA_OFFSET=1
DGA_REGULA_GROUP_ID=
DGA_CONCURRENCIA=5
DGA_COOLDOWN_MS=2000
# Control de carga DGA (0 = deshabilitado). El tope cuenta envíos a Regula. Reenviar todo: node enrolamientoDGA.js --reiniciar
DGA_MAX_REGISTROS=10000
DGA_MAX_ERROR_PCT=30
DGA_MAX_REGULA_MS=5000
DGA_API_URL=https://siass.nl.gob.mx/api/v1/fa7d8939f8914340847371e3d7afaf70

# AAP Config (SQL Server)
AAP_DB_USER=
AAP_DB_PASSWORD=
AAP_DB_SERVER=
AAP_DB_DATABASE=
AAP_DB_PORT=1433
AAP_LOTE=1000
AAP_CONCURRENCIA=5
AAP_REGULA_GROUP_ID=
# Control de carga AAP (0 = deshabilitado)
AAP_MAX_REGISTROS=5000
AAP_PAUSA_LOTE_MS=2000
AAP_MAX_ERROR_PCT=30
AAP_MAX_REGULA_MS=5000

# CISEC Config (SQL Server)
CISEC_DB_SERVER=
CISEC_DB_USER=
CISEC_DB_PASSWORD=
CISEC_DB_DATABASE=
CISEC_DB_PORT=1433
CISEC_LOTE=1000
CISEC_CONCURRENCIA=5
CISEC_REGULA_GROUP_ID=
# Control de carga CISEC (0 = deshabilitado). Reenviar todo: node enrolamientoCISEC.js --reiniciar
CISEC_MAX_REGISTROS=10000
CISEC_PAUSA_LOTE_MS=2000
CISEC_MAX_ERROR_PCT=30
CISEC_MAX_REGULA_MS=5000
